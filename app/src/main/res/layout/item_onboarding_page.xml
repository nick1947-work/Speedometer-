<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp">

    <!-- Top spacer for balanced centering -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8" />

    <!-- Center Phone Mockup Vector Illustration -->
    <ImageView
        android:id="@+id/ivOnboardingIllustration"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <!-- Middle spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0" />

    <!-- Onboarding Title -->
    <TextView
        android:id="@+id/tvOnboardingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:letterSpacing="0.01"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/text_white"
        android:textSize="26sp" />

    <!-- Onboarding Subtitle / Description -->
    <TextView
        android:id="@+id/tvOnboardingDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/text_gray"
        android:textSize="15sp" />

    <!-- Bottom spacer for page indicator and button clearance -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp" />

</LinearLayout>
