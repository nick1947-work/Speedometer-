<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:padding="24dp">

    <!-- Top Close Button -->
    <ImageView
        android:id="@+id/ivCloseGuide"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_white" />

    <!-- Step number badge (1) and Title -->
    <LinearLayout
        android:id="@+id/stepTitleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toStartOf="@id/ivCloseGuide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvStepNumber"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_step_badge"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/text_white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvGuideTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-black"
            android:text="Select No restrictions"
            android:textColor="@color/text_white"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Center Card Mockup with Orange highlight box -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mockupCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        app:cardBackgroundColor="@color/text_white"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toTopOf="@id/btnGoToSet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stepTitleContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvMockupAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Speedometer"
                android:textColor="#202124"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvMockupCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:text="BACKGROUND SETTINGS"
                android:textColor="#70757A"
                android:textSize="11sp" />

            <!-- Highlighted Setting Box with Orange Stroke -->
            <LinearLayout
                android:id="@+id/highlightBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_highlight_box_orange"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivHighlightCheck"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:src="@android:drawable/checkbox_on_background"
                    app:tint="#1976D2" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHighlightOptionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="No restrictions"
                        android:textColor="#1976D2"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvHighlightOptionDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="Battery saver doesn't restrict app's activity"
                        android:textColor="#5F6368"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Switch for autostart guide -->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchMockup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Second Option (Greyed out) -->
            <LinearLayout
                android:id="@+id/secondOptionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#F1F3F4"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Battery saver (recommended)"
                    android:textColor="#202124"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="Identify apps and activities to keep important processes going."
                    android:textColor="#5F6368"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom Blue GO TO SET Button matching screenshot -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnGoToSet"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_button_blue"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.04"
        android:text="@string/btn_go_to_set"
        android:textColor="@color/text_white"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
