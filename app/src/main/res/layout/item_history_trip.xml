<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#21252D"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card Header: Walk Icon + Trip-1 Title + Menu ⋮ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivItemTripIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_directions"
                    app:tint="@color/text_white" />

                <TextView
                    android:id="@+id/tvItemTripTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Trip-1"
                    android:textColor="@color/text_white"
                    android:textSize="18sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivItemTripMenu"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_more"
                app:tint="@color/text_gray" />
        </RelativeLayout>

        <!-- Distance & Max Speed row matching screenshot 1 (0 nm, 0 knot, Oct 12, 2026, 00:00:11) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvItemDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:fontFamily="sans-serif-black"
                android:text="0 nm"
                android:textColor="@color/text_white"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvItemSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="sans-serif-black"
                android:text="⏱ 0 knot"
                android:textColor="@color/text_white"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvItemDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvItemDistance"
                android:layout_marginTop="2dp"
                android:text="Oct 12, 2026"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvItemDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_below="@id/tvItemSpeed"
                android:layout_marginTop="2dp"
                android:text="⏱ 00:00:11"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />
        </RelativeLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#2E3440" />

        <!-- FROM Section with Red Pin -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivItemFromPin"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentStart="true"
                android:src="@drawable/ic_dot_active"
                app:tint="#FF5722" />

            <TextView
                android:id="@+id/tvItemFromLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@id/ivItemFromPin"
                android:fontFamily="sans-serif-black"
                android:text="FROM"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvItemFromTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="16:58"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvItemFromAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvItemFromLabel"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                android:layout_toEndOf="@id/ivItemFromPin"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Block H, H6, H Block, Sector 63, Noida, U..."
                android:textColor="@color/text_gray"
                android:textSize="12sp" />
        </RelativeLayout>

        <!-- Dotted connector -->
        <View
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:layout_marginStart="8dp"
            android:layout_marginVertical="2dp"
            android:background="#37474F" />

        <!-- TO Section with Green Pin -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivItemToPin"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentStart="true"
                android:src="@drawable/ic_dot_active"
                app:tint="@color/neon_green" />

            <TextView
                android:id="@+id/tvItemToLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@id/ivItemToPin"
                android:fontFamily="sans-serif-black"
                android:text="TO"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvItemToTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="16:58"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvItemToAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvItemToLabel"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                android:layout_toEndOf="@id/ivItemToPin"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Block H, H6, H Block, Sector 63, Noida, U..."
                android:textColor="@color/text_gray"
                android:textSize="12sp" />
        </RelativeLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
