<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <!-- Top Toolbar: Back Arrow, History Title, Select Action -->
    <RelativeLayout
        android:id="@+id/historyToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/ivBackHistory"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_icon_general_back"
            app:tint="@color/text_white" />

        <TextView
            android:id="@+id/tvHistoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_toEndOf="@id/ivBackHistory"
            android:fontFamily="@font/poppins_bold"
            android:text="History"
            android:textColor="@color/text_white"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvSelectHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/poppins_regular"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Select"
            android:textColor="@color/neon_cyan"
            android:textSize="15sp" />
    </RelativeLayout>

    <!-- Vehicle Filter Tabs matching screenshot: Bicycle | Motorcycle | Car | Walk -->
    <LinearLayout
        android:id="@+id/tabLayoutHistory"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_below="@id/historyToolbar"
        android:orientation="horizontal">

        <!-- Tab 0: Bicycle -->
        <RelativeLayout
            android:id="@+id/tabBicycle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabBicycle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppins_regular"
                android:text="Bicycle"
                android:textColor="#70FFFFFF"
                android:textSize="14sp" />

            <View
                android:id="@+id/indicatorBicycle"
                android:layout_width="56dp"
                android:layout_height="3dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/tab_indicator"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- Tab 1: Motorcycle -->
        <RelativeLayout
            android:id="@+id/tabMotorcycle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabMotorcycle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppins_regular"
                android:text="Motorcycle"
                android:textColor="#70FFFFFF"
                android:textSize="14sp" />

            <View
                android:id="@+id/indicatorMotorcycle"
                android:layout_width="66dp"
                android:layout_height="3dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/tab_indicator"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- Tab 2: Car -->
        <RelativeLayout
            android:id="@+id/tabCar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabCar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppins_regular"
                android:text="Car"
                android:textColor="#70FFFFFF"
                android:textSize="14sp" />

            <View
                android:id="@+id/indicatorCar"
                android:layout_width="44dp"
                android:layout_height="3dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/tab_indicator"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- Tab 3: Walk -->
        <RelativeLayout
            android:id="@+id/tabWalk"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabWalk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppins_bold"
                android:text="Walk"
                android:textColor="@color/neon_cyan"
                android:textSize="15sp" />

            <View
                android:id="@+id/indicatorWalk"
                android:layout_width="56dp"
                android:layout_height="3dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/tab_indicator"
                android:visibility="visible" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Bottom tab underline -->
    <View
        android:id="@+id/tabDividerLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@id/tabLayoutHistory"
        android:background="#20FFFFFF" />

    <!-- Trip List Cards -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistoryTrips"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/flDeleteBar"
        android:layout_below="@id/tabDividerLine"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp" />

    <!-- Empty State View -->
    <LinearLayout
        android:id="@+id/llEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/img_history_empty" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_regular"
            android:text="No trip records"
            android:textColor="#70FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Bottom Delete Bar (only visible in select mode) -->
    <FrameLayout
        android:id="@+id/flDeleteBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/rect_ff3c00_8dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_icon_general_delete"
                app:tint="@color/text_white" />

            <TextView
                android:id="@+id/tvDeleteBtnText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Delete"
                android:textColor="@color/text_white"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
