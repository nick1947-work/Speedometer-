<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:keepScreenOn="true">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:id="@+id/appTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-black"
            android:text="Speedometer"
            android:textColor="@color/text_white"
            android:textSize="20sp" />

        <!-- Action Icons: Premium/Crown, Clock/History, Floating window, Settings Gear -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivCrown"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="16dp"
                android:src="@android:drawable/btn_star_big_on"
                app:tint="#FFD700" />

            <ImageView
                android:id="@+id/ivHistory"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="16dp"
                android:src="@android:drawable/ic_menu_recent_history"
                app:tint="@color/text_gray" />

            <ImageView
                android:id="@+id/ivFloatingWindow"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="16dp"
                android:src="@android:drawable/ic_menu_view"
                app:tint="@color/text_gray" />

            <ImageView
                android:id="@+id/ivSettings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="@color/text_gray" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Top GPS Satellite status pill (Target for Tour) -->
    <LinearLayout
        android:id="@+id/gpsStatusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_gps_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appTopBar">

        <ImageView
            android:id="@+id/ivGpsSignalIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_dot_active"
            app:tint="@color/neon_green" />

        <TextView
            android:id="@+id/tvGpsPillText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/gps_status_excellent"
            android:textColor="@color/text_white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 4 Tabs Bar: Gauge | Digital | Map | Nav matching screenshots -->
    <LinearLayout
        android:id="@+id/tabsContainer"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gpsStatusPill">

        <!-- Tab 1: Gauge -->
        <FrameLayout
            android:id="@+id/tabGauge"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabGauge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                android:text="@string/tab_gauge"
                android:textColor="@color/neon_cyan"
                android:textSize="16sp" />

            <View
                android:id="@+id/indicatorGauge"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:background="@color/neon_cyan" />
        </FrameLayout>

        <!-- Tab 2: Digital -->
        <FrameLayout
            android:id="@+id/tabDigital"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabDigital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tab_digital"
                android:textColor="@color/text_gray"
                android:textSize="15sp" />

            <View
                android:id="@+id/indicatorDigital"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:background="@color/neon_cyan"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- Tab 3: Map -->
        <FrameLayout
            android:id="@+id/tabMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tab_map"
                android:textColor="@color/text_gray"
                android:textSize="15sp" />

            <View
                android:id="@+id/indicatorMap"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:background="@color/neon_cyan"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- Tab 4: Nav -->
        <FrameLayout
            android:id="@+id/tabNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabNav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tab_nav"
                android:textColor="@color/text_gray"
                android:textSize="15sp" />

            <View
                android:id="@+id/indicatorNav"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:background="@color/neon_cyan"
                android:visibility="invisible" />
        </FrameLayout>

    </LinearLayout>

    <!-- Center Content / Speed Dial Cockpit -->
    <FrameLayout
        android:id="@+id/dialCenterContainer"
        android:layout_width="290dp"
        android:layout_height="290dp"
        app:layout_constraintBottom_toTopOf="@id/vehicleModeSelector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabsContainer"
        app:layout_constraintVertical_bias="0.35">

        <!-- Dial Outer Rings & Numbers -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_analog_dial_gauge" />

        <!-- Center Digital Readout & Unit -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMainSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="@color/neon_cyan"
                android:textSize="82sp"
                tools:text="72" />

            <TextView
                android:id="@+id/tvMainUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="km/h"
                android:textColor="@color/neon_cyan"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:text="Odometer"
                android:textColor="@color/text_dark_gray"
                android:textSize="11sp" />

            <!-- Retro 6-digit odometer readout 000000 km -->
            <TextView
                android:id="@+id/tvOdometerValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:text="000000 km"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Vehicle Mode Selector: Walking | Bicycle | Motorcycle | Car -->
    <LinearLayout
        android:id="@+id/vehicleModeSelector"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/dashboardMetricsGrid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/ivModeWalk"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="8dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_directions"
            app:tint="@color/text_dark_gray" />

        <ImageView
            android:id="@+id/ivModeBicycle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="8dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_compass"
            app:tint="@color/text_dark_gray" />

        <ImageView
            android:id="@+id/ivModeMoto"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="8dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="@color/text_dark_gray" />

        <!-- Selected Vehicle Mode (Car) matching screenshot -->
        <FrameLayout
            android:id="@+id/ivModeCarContainer"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_vehicle_selected">

            <ImageView
                android:id="@+id/ivModeCar"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_mapmode"
                app:tint="@color/neon_cyan" />
        </FrameLayout>
    </LinearLayout>

    <!-- Dashboard Metrics Grid (2x2 matching exact screenshot) -->
    <GridLayout
        android:id="@+id/dashboardMetricsGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="18dp"
        android:columnCount="2"
        android:rowCount="2"
        app:layout_constraintBottom_toTopOf="@id/btnMainAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Duration -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="⏱ Duration"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00:00"
                android:textColor="@color/neon_cyan"
                android:textSize="21sp" />
        </LinearLayout>

        <!-- Distance -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="📍 Distance"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0 km"
                android:textColor="@color/neon_cyan"
                android:textSize="21sp" />
        </LinearLayout>

        <!-- Avg Speed -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="📈 Avg speed"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAvgSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0 km/h"
                android:textColor="@color/neon_cyan"
                android:textSize="21sp" />
        </LinearLayout>

        <!-- Max Speed -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="⚡ Max speed"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvMaxSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0 km/h"
                android:textColor="@color/neon_cyan"
                android:textSize="21sp" />
        </LinearLayout>

    </GridLayout>

    <!-- Big Cyan Pill Action Button: ▶ START -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnMainAction"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="36dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_button_start_pill"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.08"
        android:text="▶  START"
        android:textColor="@color/bg_black"
        android:textSize="17sp"
        app:layout_constraintBottom_toTopOf="@id/adViewContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom Banner Ad -->
    <FrameLayout
        android:id="@+id/adViewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Included First Time Feature Tour Overlay (Gone by default) -->
    <include
        android:id="@+id/tourLayout"
        layout="@layout/view_feature_tour"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
