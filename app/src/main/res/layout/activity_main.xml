<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:keepScreenOn="true">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:id="@+id/appTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/poppins_bold"
            android:text="Speedometer"
            android:textColor="@color/text_white"
            android:textSize="20sp" />

        <!-- Action Icons from original APK: King Crown, History, Rotate/Mirror, Settings -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivCrown"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/icon_king" />

            <ImageView
                android:id="@+id/ivHistory"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_icon_general_history" />

            <ImageView
                android:id="@+id/ivFloatingWindow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_icon_general_rotate" />

            <ImageView
                android:id="@+id/ivSettings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_icon_general_settings" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Top GPS Satellite status pill (Target for Tour) -->
    <LinearLayout
        android:id="@+id/gpsStatusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_gps_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appTopBar">

        <ImageView
            android:id="@+id/ivGpsSignalIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_dot_active"
            app:tint="@color/neon_green" />

        <TextView
            android:id="@+id/tvGpsPillText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/gps_status_excellent"
            android:textColor="@color/text_white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 4 Tabs Bar: Gauge | Digital | Map | Nav -->
    <LinearLayout
        android:id="@+id/tabsContainer"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gpsStatusPill">

        <!-- Tab 1: Gauge -->
        <FrameLayout
            android:id="@+id/tabGauge"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabGauge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                android:text="@string/tab_gauge"
                android:textColor="@color/neon_cyan"
                android:textSize="16sp" />

            <View
                android:id="@+id/indicatorGauge"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:background="@color/neon_cyan" />
        </FrameLayout>

        <!-- Tab 2: Digital -->
        <FrameLayout
            android:id="@+id/tabDigital"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabDigital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tab_digital"
                android:textColor="@color/text_gray"
                android:textSize="15sp" />

            <View
                android:id="@+id/indicatorDigital"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:background="@color/neon_cyan"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- Tab 3: Map -->
        <FrameLayout
            android:id="@+id/tabMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tab_map"
                android:textColor="@color/text_gray"
                android:textSize="15sp" />

            <View
                android:id="@+id/indicatorMap"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:background="@color/neon_cyan"
                android:visibility="invisible" />
        </FrameLayout>

        <!-- Tab 4: Nav -->
        <FrameLayout
            android:id="@+id/tabNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tvTabNav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tab_nav"
                android:textColor="@color/text_gray"
                android:textSize="15sp" />

            <View
                android:id="@+id/indicatorNav"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:background="@color/neon_cyan"
                android:visibility="invisible" />
        </FrameLayout>

    </LinearLayout>

    <!-- TAB 1 & 2 CONTAINER: Gauge & Digital Cockpit -->
    <LinearLayout
        android:id="@+id/gaugeViewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/tripControlBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabsContainer">

        <!-- Center Cockpit Dial -->
        <FrameLayout
            android:id="@+id/dialCenterContainer"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="10dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg_analog_dial_gauge" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMainSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="@color/neon_cyan"
                    android:textSize="82sp"
                    tools:text="72" />

                <TextView
                    android:id="@+id/tvMainUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="km/h"
                    android:textColor="@color/neon_cyan"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:text="Odometer"
                    android:textColor="@color/text_dark_gray"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvOdometerValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:text="000000 km"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Vehicle Mode Selector -->
        <LinearLayout
            android:id="@+id/vehicleModeSelector"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/ivModeWalkContainer"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_vehicle_selected">

                <ImageView
                    android:id="@+id/ivModeWalk"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_transport_walking"
                    app:tint="@color/neon_cyan" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/ivModeBicycleContainer"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp">

                <ImageView
                    android:id="@+id/ivModeBicycle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_transport_bicycle"
                    app:tint="@color/text_dark_gray" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/ivModeMotoContainer"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp">

                <ImageView
                    android:id="@+id/ivModeMoto"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_traffic_motorcycle"
                    app:tint="@color/text_dark_gray" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/ivModeCarContainer"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp">

                <ImageView
                    android:id="@+id/ivModeCar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_traffic_car"
                    app:tint="@color/text_dark_gray" />
            </FrameLayout>
        </LinearLayout>

        <!-- 2x2 Metrics Grid with Original Drawables & Poppins Fonts -->
        <GridLayout
            android:id="@+id/dashboardMetricsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:columnCount="2"
            android:rowCount="2">

            <!-- Duration Metric Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/rect_10ffffff_16dp"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_icon_gauge_duration"
                        app:tint="@color/text_gray" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Duration"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="00:00:00"
                    android:textColor="@color/neon_cyan"
                    android:textSize="19sp" />
            </LinearLayout>

            <!-- Distance Metric Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/rect_10ffffff_16dp"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_icon_gauge_distance"
                        app:tint="@color/text_gray" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Distance"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="0 km"
                    android:textColor="@color/neon_cyan"
                    android:textSize="19sp" />
            </LinearLayout>

            <!-- Avg Speed Metric Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/rect_10ffffff_16dp"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_icon_gauge_avgspeed"
                        app:tint="@color/text_gray" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Avg.Speed"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAvgSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="0 km/h"
                    android:textColor="@color/neon_cyan"
                    android:textSize="19sp" />
            </LinearLayout>

            <!-- Max Speed Metric Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/rect_10ffffff_16dp"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_icon_gauge_maxspeed"
                        app:tint="@color/text_gray" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Max.Speed"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMaxSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="0 km/h"
                    android:textColor="@color/neon_cyan"
                    android:textSize="19sp" />
            </LinearLayout>
        </GridLayout>

    </LinearLayout>

    <!-- TAB 3: Map Tab Included -->
    <include
        android:id="@+id/includedMapTab"
        layout="@layout/view_map_tab"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/adViewContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabsContainer" />

    <!-- TAB 4: Nav Tab Included -->
    <include
        android:id="@+id/includedNavTab"
        layout="@layout/view_nav_tab"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/adViewContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabsContainer" />

    <!-- Controls Row: State 1 (Single Big START Pill) & State 2 (Reset | STOP | Pause) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnMainAction"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="36dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/rect_00fff2_90dp"
        android:fontFamily="@font/poppins_bold"
        android:letterSpacing="0.04"
        android:text="START"
        android:textColor="@color/bg_black"
        android:textSize="18sp"
        android:visibility="visible"
        app:drawableStartCompat="@drawable/ic_icon_general_start"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@id/adViewContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/tripControlBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/adViewContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/btnResetTripCol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/ripple_rect_363637_90dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_icon_general_reset" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Reset"
                android:textColor="@color/text_gray"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStopTrip"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_weight="1"
            android:background="@drawable/rect_ff3c00_8dp"
            android:fontFamily="@font/poppins_bold"
            android:letterSpacing="0.04"
            android:text="STOP"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            app:drawableStartCompat="@drawable/ic_icon_general_stop"
            android:paddingHorizontal="20dp" />

        <LinearLayout
            android:id="@+id/btnPauseTripCol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/ripple_rect_007bff_90dp">

                <ImageView
                    android:id="@+id/ivPauseIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_icon_general_pause" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvPauseText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Pause"
                android:textColor="@color/text_gray"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Banner Ad -->
    <FrameLayout
        android:id="@+id/adViewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Feature Tour Overlay -->
    <include
        android:id="@+id/tourLayout"
        layout="@layout/view_feature_tour"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
