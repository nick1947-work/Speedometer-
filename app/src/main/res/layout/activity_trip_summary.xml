<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tripSummaryScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- Top Action Bar (Back, Vehicle Icon, Title, Date, 3-dots Menu) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBarTrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="6dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivBackTrip"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="5dp"
                android:src="@drawable/ic_icon_general_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/text_white" />

            <ImageView
                android:id="@+id/ivTripModeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_traffic_car"
                app:layout_constraintBottom_toBottomOf="@id/tvTripName"
                app:layout_constraintStart_toEndOf="@id/ivBackTrip"
                app:layout_constraintTop_toTopOf="@id/tvTripName"
                app:tint="@color/text_white" />

            <TextView
                android:id="@+id/tvTripName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:text="Trip-4"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                app:layout_constraintEnd_toStartOf="@id/ivTripMenuMore"
                app:layout_constraintStart_toEndOf="@id/ivTripModeIcon"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTripDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:text="Oct 14, 2026"
                android:textColor="#8E8E93"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="@id/ivTripModeIcon"
                app:layout_constraintTop_toBottomOf="@id/tvTripName" />

            <ImageView
                android:id="@+id/ivTripMenuMore"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="5dp"
                android:src="@drawable/ic_icon_general_more"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/text_white" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Metrics Panel (Distance, Duration, Avg.Speed, Max.Speed) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/metricsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/topBarTrip">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/metricsCenterGuideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.45" />

            <!-- Row 1 Left: Distance -->
            <LinearLayout
                android:id="@+id/colDistance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@id/metricsCenterGuideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Distance"
                    android:textColor="#8E8E93"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSummaryDistanceVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="@color/text_white"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/tvSummaryDistanceUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:text="nm"
                        android:textColor="@color/text_white"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 1 Right: Duration -->
            <LinearLayout
                android:id="@+id/colDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/metricsCenterGuideline"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Duration"
                    android:textColor="#8E8E93"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSummaryDurationVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:text="00:00:00"
                    android:textColor="@color/text_white"
                    android:textSize="30sp" />
            </LinearLayout>

            <!-- Row 2 Left: Avg.Speed -->
            <LinearLayout
                android:id="@+id/colAvgSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@id/metricsCenterGuideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/colDistance">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Avg.Speed"
                    android:textColor="#8E8E93"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSummaryAvgSpeedVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="@color/text_white"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/tvSummaryAvgSpeedUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:text="knot"
                        android:textColor="@color/text_white"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2 Right: Max.Speed -->
            <LinearLayout
                android:id="@+id/colMaxSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/metricsCenterGuideline"
                app:layout_constraintTop_toBottomOf="@id/colDuration">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Max.Speed"
                    android:textColor="#8E8E93"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSummaryMaxSpeedVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="@color/text_white"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/tvSummaryMaxSpeedUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:text="knot"
                        android:textColor="@color/text_white"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Route Address Card (FROM & TO) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/rect_10ffffff_16dp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="18dp"
            app:layout_constraintTop_toBottomOf="@id/metricsPanel">

            <!-- FROM PIN (Red/Orange) -->
            <ImageView
                android:id="@+id/ivPinFrom"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_icon_general_location_start"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvFromLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:text="FROM"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/ivPinFrom"
                app:layout_constraintStart_toEndOf="@id/ivPinFrom"
                app:layout_constraintTop_toTopOf="@id/ivPinFrom" />

            <TextView
                android:id="@+id/tvFromTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:text="02:31"
                android:textColor="#8E8E93"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/ivPinFrom"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/ivPinFrom" />

            <TextView
                android:id="@+id/tvFromAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/poppins_regular"
                android:text="--"
                android:textColor="#8E8E93"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/tvFromTime"
                app:layout_constraintStart_toStartOf="@id/tvFromLabel"
                app:layout_constraintTop_toBottomOf="@id/tvFromLabel" />

            <!-- Dashed Line Connector -->
            <View
                android:id="@+id/dashConnector"
                android:layout_width="2dp"
                android:layout_height="26dp"
                android:layout_marginVertical="2dp"
                android:background="@drawable/dot_gap_bg"
                app:layout_constraintBottom_toTopOf="@id/ivPinTo"
                app:layout_constraintEnd_toEndOf="@id/ivPinFrom"
                app:layout_constraintStart_toStartOf="@id/ivPinFrom"
                app:layout_constraintTop_toBottomOf="@id/ivPinFrom" />

            <!-- TO PIN (Green) -->
            <ImageView
                android:id="@+id/ivPinTo"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="28dp"
                android:src="@drawable/ic_icon_general_location_end"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivPinFrom" />

            <TextView
                android:id="@+id/tvToLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:text="TO"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/ivPinTo"
                app:layout_constraintStart_toEndOf="@id/ivPinTo"
                app:layout_constraintTop_toTopOf="@id/ivPinTo" />

            <TextView
                android:id="@+id/tvToTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:text="02:31"
                android:textColor="#8E8E93"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/ivPinTo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/ivPinTo" />

            <TextView
                android:id="@+id/tvToAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/poppins_regular"
                android:text="--"
                android:textColor="#8E8E93"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/tvToTime"
                app:layout_constraintStart_toStartOf="@id/tvToLabel"
                app:layout_constraintTop_toBottomOf="@id/tvToLabel" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Map View Section Title -->
        <TextView
            android:id="@+id/tvMapViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Map View"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardAddress" />

        <!-- Map View Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/summaryMapCard"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#1A1C22"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvMapViewTitle">

            <org.osmdroid.views.MapView
                android:id="@+id/summaryMapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
