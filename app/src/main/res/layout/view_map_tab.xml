<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mapScreenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <!-- Top GPS Satellite status & Toolbar are managed in MainActivity tabs -->
    <!-- Center Map Canvas (Satellite View / Street Map) -->
    <FrameLayout
        android:id="@+id/mapContainerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#2E3440"
        app:layout_constraintBottom_toTopOf="@id/mapBottomControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Left Floating Digital Speed readout pill matching screenshot 2 (0) -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_dialog_dark">

            <TextView
                android:id="@+id/tvMapFloatingSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                android:text="0"
                android:textColor="@color/neon_cyan"
                android:textSize="20sp" />
        </FrameLayout>

        <!-- Right Side Map Action Buttons (Map layer switch + GPS target centering) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="16dp"
            android:orientation="vertical">

            <!-- Layers Button (Street / Satellite) -->
            <FrameLayout
                android:id="@+id/btnMapLayerToggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_dark_btn">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_dialog_map"
                    app:tint="@color/text_white" />
            </FrameLayout>

            <!-- Re-center Location Target Button -->
            <FrameLayout
                android:id="@+id/btnMapRecenter"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_circle_dark_btn">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_mylocation"
                    app:tint="@color/neon_cyan" />
            </FrameLayout>
        </LinearLayout>

        <!-- Bottom Left Latitude & Longitude Chip matching screenshot 2 -->
        <TextView
            android:id="@+id/tvMapCoordinates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="16dp"
            android:background="@drawable/bg_gps_pill"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text='28°37&apos;50.0"N , 77°22&apos;45.6"E'
            android:textColor="@color/text_white"
            android:textSize="11sp" />
    </FrameLayout>

    <!-- Bottom Controls & Metrics matching screenshot 2 -->
    <LinearLayout
        android:id="@+id/mapBottomControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_black"
        android:orientation="vertical"
        android:paddingTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Vehicle Mode Selector (Walk | Bike | Moto | Car) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_directions"
                app:tint="@color/text_dark_gray" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_compass"
                app:tint="@color/text_dark_gray" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_vehicle_selected">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_agenda"
                    app:tint="@color/neon_cyan" />
            </FrameLayout>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_mapmode"
                app:tint="@color/text_dark_gray" />
        </LinearLayout>

        <!-- 2x2 Metrics Grid (Duration, Distance, Avg speed, Max speed) -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:columnCount="2"
            android:rowCount="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱ Duration"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvMapDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="00:00:04"
                    android:textColor="@color/neon_cyan"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Distance"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvMapDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0 nm"
                    android:textColor="@color/neon_cyan"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📈 Avg speed"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvMapAvgSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0 knot"
                    android:textColor="@color/neon_cyan"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Max speed"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvMapMaxSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0 knot"
                    android:textColor="@color/neon_cyan"
                    android:textSize="20sp" />
            </LinearLayout>
        </GridLayout>

        <!-- 3-Button Controls (Reset | STOP | Pause) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnMapReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circle_dark_btn">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_rotate"
                        app:tint="@color/text_white" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Reset"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMapStop"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginHorizontal="16dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_stop_pill"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:text="■  STOP"
                android:textColor="@color/neon_cyan"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/btnMapPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circle_blue_btn">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_media_pause"
                        app:tint="@color/text_white" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pause"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
