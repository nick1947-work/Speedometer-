<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clParent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dimen_8_dp"
    android:background="@drawable/shape_gradient_unselected"
    android:padding="@dimen/dimen_12_dp">

    <RadioButton
        android:visibility="gone"
        android:id="@+id/radioButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@drawable/selector_iap_listing_item"
        android:checked="false"
        android:clickable="false"
        android:focusable="false"
         app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:visibility="gone"
        android:layout_marginTop="@dimen/dimen_15_dp"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="@dimen/dimen_2_dp"
        android:elevation="@dimen/dimen_1_dp"
        app:layout_constraintEnd_toEndOf="@+id/linearLayout"
        app:layout_constraintStart_toEndOf="@+id/linearLayout"
        android:src="@drawable/crown_icon"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintTop_toTopOf="@+id/linearLayout" />



    <LinearLayout
        android:layout_marginTop="16dp"
        android:id="@+id/linearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dimen_12_dp"
        app:layout_constraintEnd_toEndOf="@+id/frmlStrikeThrough"
        app:layout_constraintStart_toStartOf="@+id/frmlStrikeThrough"
        app:layout_constraintTop_toBottomOf="@+id/tvPrice"
        app:layout_constraintStart_toEndOf="@+id/radioButton"
 >

        <TextView
            android:layout_gravity="center"
            android:id="@+id/tvPackName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/roboto_medium"
            android:singleLine="true"
            android:text="11"
            android:textColor="#5A5A5A"
            android:textSize="@dimen/dimen_14_dp" />

        <TextView
            android:id="@+id/tvValidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:visibility="gone"
            android:textColor="#5A5A5A"
            android:textSize="@dimen/dimen_10_dp" />

        <TextView
            android:id="@+id/tvRecommended"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Recommended"
            android:fontFamily="@font/roboto_regular"
            android:textColor="#5A5A5A"
            android:textSize="@dimen/dimen_12_dp" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/frmlStrikeThrough"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dimen_14_dp"
        app:layout_constraintEnd_toEndOf="parent"
         app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvStrikeThroughPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:text=""
            android:fontFamily="@font/roboto_medium"
            android:textColor="#5A5A5A"
            android:textSize="@dimen/dimen_16_sp" />

        <View
            android:layout_width="@dimen/dimen_60_dp"
            android:layout_height="@dimen/dimen_2_dp"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/dimen_4_dp"
            android:background="#ED1919" />

    </RelativeLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5012658" />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="#5A5A5A"
        android:textSize="@dimen/dimen_24_sp"
        android:fontFamily="@font/roboto_medium"
        app:layout_constraintTop_toBottomOf="@+id/frmlStrikeThrough"
        app:layout_constraintEnd_toEndOf="@+id/frmlStrikeThrough"
        app:layout_constraintStart_toStartOf="@+id/frmlStrikeThrough"

        />
</androidx.constraintlayout.widget.ConstraintLayout>