    <string name="themes_title" translatable="false">テーマ</string>
    <string name="themes_description1" translatable="false">アプリをカスタマイズするための20以上のプレミアムテーマ。</string>
    <string name="themes_description2" translatable="false">アプリの外観と感触を個別化できます。</string>
    <string name="themes_description3" translatable="false">グラデーションまたはダークモードテーマを使用して目の疲れを軽減。</string>

    <string name="trash_title" translatable="false">ゴミ箱</string>
    <string name="trash_description1" translatable="false">写真や動画などの不要なファイルを簡単に削除。</string>
    <string name="trash_description2" translatable="false">ストレージスペースを整理し、混乱を防ぎます。</string>
    <string name="trash_description3" translatable="false">安全ネットを提供して、誤って削除したファイルを防ぎます。</string>

    <string name="ad_free_title" translatable="false">広告なし</string>
    <string name="ad_free_description1" translatable="false">広告なしで主要機能を楽しめます。</string>
    <string name="ad_free_description2" translatable="false">ページの読み込み時間が短縮され、全体的なパフォーマンスが向上します。</string>
    <string name="ad_free_description3" translatable="false">データ使用量を削減し、モバイルデータを節約できる可能性があります。</string>

    <string name="crop_title" translatable="false">トリミング</string>
    <string name="crop_description1" translatable="false">画像や動画のサイズとアスペクト比を調整。</string>
    <string name="crop_description2" translatable="false">写真や動画から不要な要素を取り除き、構図を改善。</string>
    <string name="crop_description3" translatable="false">大きな画像や動画のファイルサイズを削減し、ストレージスペースを節約。</string>

    <string name="lyrics_title" translatable="false">歌詞</string>
    <string name="lyrics_description1" translatable="false">オンライン歌詞付きで無制限の音楽再生</string>
    <string name="lyrics_description2" translatable="false">お気に入りの曲の歌詞を簡単に追跡できます。</string>
    <string name="lyrics_description3" translatable="false">オンラインおよびオフラインの音楽体験を向上させます。</string>

    <string name="filter_duplicate_title" translatable="false">重複フィルター</string>
    <string name="filter_duplicate_description1" translatable="false">重複ファイルからデバイスを保護するための生涯無制限使用</string>
    <string name="filter_duplicate_description2" translatable="false">重複ファイルを特定し、削除して時間を節約し、混乱を防ぎます</string>
    <string name="filter_duplicate_description3" translatable="false">不要なファイルのコピーを削除して、ストレージスペースを削減します。</string>

    <string name="upcoming_feature_title" translatable="false">今後の機能</string>
